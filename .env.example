# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 필수 (Required)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Gemini API 키 — https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: 무료 BGM 검색 (Optional - free music search)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# https://devportal.jamendo.com/ 에서 무료 가입 후 client_id 발급
# 없으면 자동으로 기본 BGM(public/bgm.wav) 사용
JAMENDO_CLIENT_ID=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: AI 음악 생성 Lyria 2 ($0.06/30초)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 옵션 A: API 키 (Vertex AI Express Mode - 더 간단)
VERTEX_AI_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
# 옵션 B: 서비스 계정 JSON 한 줄 (옵션 A 안 될 때 폴백)
VERTEX_AI_KEY_JSON=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: Instagram 자동 발행 (Reels)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Meta for Developers (https://developers.facebook.com/) Instagram Business Login 필요
# Account ID는 숫자만 (예: 17841...)
INSTA_ACCOUNT_ID=
INSTA_ACCESS_TOKEN=
INSTA_API_VERSION=v23.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: YouTube Shorts 자동 발행
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GCP에서 YouTube Data API v3 활성화 + OAuth 클라이언트 ID 생성
# 그 다음 `node scripts/youtube-oauth.mjs` 실행하면 REFRESH_TOKEN 자동 채워짐
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: Firebase Storage (영상 호스팅, IG 발행에 필요)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 비어있으면 catbox.moe (무료, 무인증) 자동 사용
FIREBASE_ADMIN_KEY_JSON=

# Firebase 클라이언트 SDK (legacy 카드뉴스 페이지에서만 사용)
# 사용 안 하면 비워둬도 OK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: 자동 토픽 발굴용 NewsAPI (auto-shorts 스킬)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# https://newsapi.org/ 무료 가입 (일 100 req)
# 없으면 pool/ai 전략으로 폴백
NEWS_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: Slack 봇 연동
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SLACK_SIGNING_SECRET=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: E형 애니메이션 (GPT-Image-2 + Wan 2.2 Ultra Fast)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# https://wavespeed.ai/accesskey 에서 발급
# GPT-Image-2: ~$0.06-0.18/장 | Wan 2.2: $0.01/초
WAVESPEED_API_KEY=
# 모델 ID 오버라이드 (기본값 내장, WaveSpeed 슬러그 변경 시만 사용)
# WAVESPEED_MODEL_IMAGE=openai/gpt-image-2/text-to-image
# WAVESPEED_MODEL_T2V=wavespeed-ai/wan-v2.2-ultra-fast/t2v
# WAVESPEED_MODEL_I2V=wavespeed-ai/wan-v2.2-ultra-fast/img2vid

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 선택: 포토 카드뉴스 배경 미디어 (이미지 + 영상)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Pixabay (무료 이미지 + 영상) — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Pexels (무료 이미지 + 영상) — https://www.pexels.com/api/
PEXELS_API_KEY=

# Canva Connect API (폴백, 내 라이브러리 자산 사용)
# 설정: npx tsx scripts/canva-oauth.mjs
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 사용 안 함: 기존 카드뉴스 시스템 (legacy)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
OPENAI_API_KEY=
